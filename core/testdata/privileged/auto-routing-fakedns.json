{
  "core_config": {
    "log": {
      "level": "info",
      "timestamp": true
    },
    "dns": {
      "servers": [
        {
          "type": "https",
          "server": "dns.example",
          "path": "/synthetic-dns-query",
          "tag": "dns-remote",
          "detour": "proxy",
          "domain_resolver": "dns-local"
        },
        {
          "type": "https",
          "server": "1.1.1.1",
          "path": "/dns-query",
          "tag": "dns-direct",
          "domain_resolver": "dns-local"
        },
        {
          "type": "local",
          "tag": "dns-local"
        },
        {
          "tag": "dns-fake",
          "type": "fakeip",
          "inet4_range": "198.18.0.0/15",
          "inet6_range": "fc00::/18"
        }
      ],
      "rules": [
        {
          "query_type": [
            "A",
            "AAAA"
          ],
          "action": "route",
          "server": "dns-fake"
        },
        {
          "action": "route",
          "server": "dns-direct",
          "rule_set": [
            "geosite-private"
          ]
        },
        {
          "action": "route",
          "server": "dns-remote",
          "strategy": "prefer_ipv4"
        }
      ],
      "independent_cache": true
    },
    "inbounds": [
      {
        "type": "mixed",
        "tag": "mixed-in",
        "listen": "127.0.0.1",
        "listen_port": 2080
      },
      {
        "type": "tun",
        "tag": "tun-in",
        "address": [
          "172.19.0.1/30",
          "fdfe:dcba:9876::1/126"
        ],
        "mtu": 1500,
        "auto_route": true,
        "strict_route": true,
        "stack": "mixed",
        "auto_redirect": true
      }
    ],
    "outbounds": [
      {
        "type": "vless",
        "server": "proxy.example",
        "server_port": 443,
        "uuid": "00000000-0000-0000-0000-000000000001",
        "flow": "xtls-rprx-vision",
        "packet_encoding": "xudp",
        "tls": {
          "enabled": true,
          "server_name": "proxy.example",
          "utls": {
            "enabled": true,
            "fingerprint": "chrome"
          },
          "reality": {
            "enabled": true,
            "public_key": "SYNTHETIC_KEY",
            "short_id": "aa"
          }
        },
        "tag": "p-0"
      },
      {
        "type": "hysteria2",
        "server": "proxy.example",
        "server_port": 443,
        "password": "synthetic-password",
        "obfs": {
          "type": "salamander",
          "password": "synthetic-obfs"
        },
        "up_mbps": 50,
        "down_mbps": 100,
        "tls": {
          "enabled": true,
          "server_name": "proxy.example"
        },
        "tag": "p-1"
      },
      {
        "type": "auto-selector",
        "tag": "proxy",
        "outbounds": [
          "p-0",
          "p-1"
        ],
        "url": "https://test.example/generate_204",
        "interval": "180s",
        "tolerance": 150,
        "timeout": "5000ms",
        "concurrency": 16,
        "dial_retries": 2,
        "balance": true,
        "balance_mode": "rotate"
      },
      {
        "type": "direct",
        "tag": "direct"
      }
    ],
    "route": {
      "rules": [
        {
          "action": "sniff"
        },
        {
          "protocol": "dns",
          "action": "hijack-dns"
        },
        {
          "inbound": [
            "mixed-in",
            "tun-in"
          ],
          "action": "resolve",
          "strategy": "prefer_ipv4"
        },
        {
          "type": "logical",
          "mode": "or",
          "rules": [
            {
              "domain_suffix": [
                "synthetic.example"
              ]
            },
            {
              "process_path": [
                "/synthetic/application"
              ]
            }
          ],
          "action": "route",
          "outbound": "direct"
        },
        {
          "action": "route",
          "outbound": "direct",
          "ip_is_private": true
        },
        {
          "action": "route",
          "outbound": "direct",
          "rule_set": [
            "geosite-private"
          ]
        }
      ],
      "final": "proxy",
      "default_domain_resolver": {
        "server": "dns-direct",
        "strategy": "prefer_ipv4"
      },
      "rule_set": [
        {
          "type": "remote",
          "tag": "geosite-private",
          "format": "binary",
          "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-private.srs",
          "download_detour": "proxy"
        }
      ],
      "find_process": true,
      "auto_detect_interface": true
    },
    "experimental": {
      "cache_file": {
        "enabled": true,
        "store_fakeip": true,
        "path": "/synthetic/user/cache.db"
      },
      "clash_api": {
        "default_mode": ""
      }
    }
  },
  "xray_config": null
}
